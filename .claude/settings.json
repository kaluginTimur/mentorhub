{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "idleCompaction": false,
  "permissions": {
    "allow": [
      "Bash(./mvnw verify *)",
      "Bash(./mvnw -B verify *)",
      "Bash(./mvnw -B -q verify *)",
      "Bash(./mvnw spotless:apply *)",
      "Bash(./mvnw generate-sources *)",
      "Bash(./mvnw -q generate-sources *)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw -q dependency:build-classpath *)",
      "Bash(unzip -l *)",
      "Bash(javap *)",
      "Bash(npm ci *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm run generate:api *)",
      "Bash(~/.nvm/nvm-exec npm ci *)",
      "Bash(~/.nvm/nvm-exec npm test *)",
      "Bash(~/.nvm/nvm-exec npm run lint *)",
      "Bash(~/.nvm/nvm-exec npm run build *)",
      "Bash(~/.nvm/nvm-exec npm run format *)",
      "Bash(~/.nvm/nvm-exec npm run format:check *)",
      "Bash(~/.nvm/nvm-exec npm run generate:api *)",
      "Bash(node scripts/check-docs.mjs *)",
      "Bash(node scripts/check-path.mjs *)",
      "Bash(node .claude/scripts/agent-usage.mjs *)",
      "Bash(node scripts/requirements.mjs *)",
      "Bash(node --test scripts/requirements.test.mjs *)",
      "Bash(~/.nvm/nvm-exec npx playwright-cli *)",
      "Bash(curl -sS -o /dev/null -w \"%{http_code}\" http://localhost:4200)",
      "Bash(curl -sS http://localhost:8080/actuator/health)",
      "Bash(mkdir -p *.screens/*)",
      "Bash(setsid sh -c 'echo $$ > *.screens/*/backend.pgid; exec ./mvnw spring-boot:run' *)",
      "Bash(setsid sh -c 'echo $$ > *.screens/*/frontend.pgid; exec ~/.nvm/nvm-exec npm start' *)",
      "Bash(gh auth status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume remove *)",
      "Bash(docker volume prune *)",
      "Bash(dropdb *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git reflog expire *)",
      "Bash(git update-ref -d *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-frontend.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
